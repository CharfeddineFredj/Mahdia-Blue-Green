# API backend (suffixe /api). Ex. http://localhost:5000/api ou, en prod derrière le même domaine, laisser vide : le front utilisera automatiquement {origine}/api (reverse proxy → backend).
VITE_API_URL=http://localhost:5000/api

# Origine du serveur API pour « Continuer avec Google » (sans /api). Sinon déduit de VITE_API_URL ; si API sur :5173 → OAuth sur :5000.
# VITE_OAUTH_BACKEND_ORIGIN=http://localhost:5000
# VITE_OAUTH_BACKEND_PORT=5000

# Floating chat widget (dolphinbot). Set to false to hide.
VITE_ENABLE_CHATBOT=true

# Live AI (dolphinbot) uses POST /api/chat on the backend — set OPENROUTER_API_KEY in Backend/.env (not here).
